      "parameters": {
        "jsCode": "const msg = items[0].json;\n\nconst parts = msg.payload?.parts || [];\nconst attachments = [];\n\nfunction extractAttachments(parts, messageId) {\n  for (const part of parts) {\n    if (part.filename && part.body?.attachmentId) {\n      // Only push if it's a PDF file\n      const isPdf = part.mimeType === 'application/pdf' || part.filename.endsWith('.pdf');\n      if (isPdf) {\n        attachments.push({\n          filename: part.filename,\n          attachmentId: part.body.attachmentId,\n          mimeType: part.mimeType,\n          messageId: messageId\n        });\n      }\n    }\n\n    // Recursive extraction for nested parts\n    if (part.parts) {\n      extractAttachments(part.parts, messageId);\n    }\n  }\n}\n\n// Start extraction\nextractAttachments(parts, msg.id);\n\n// If no PDFs found, return null object or original info\nif (attachments.length === 0) {\n  return [\n    {\n      json: {\n        subject: msg.Subject || \"No Subject\",\n        from: msg.From || \"Unknown Sender\",\n        to: msg.To || \"No Recipient\",\n        body: msg.snippet || \"No Body Available\",\n        messageId: msg.id\n      }\n    }\n  ];\n}\n\n// Return only PDF attachments\nreturn attachments.map(a => ({\n  json: {\n    ...a,\n    subject: msg.Subject,\n    from: msg.From,\n    to: msg.To,\n    snippet: msg.snippet,\n    messageId: msg.id\n  }\n}));\n"
      },
